<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#FF0F1115</Color>
    <Color x:Key="SurfaceColor">#FF181B22</Color>
    <Color x:Key="SurfaceAltColor">#FF20242D</Color>
    <Color x:Key="SurfaceHoverColor">#FF262B36</Color>
    <Color x:Key="SurfacePressedColor">#FF1B1F28</Color>
    <Color x:Key="BorderColor">#FF2A2F3A</Color>
    <Color x:Key="BorderHoverColor">#FF3A4150</Color>
    <Color x:Key="TextColor">#FFE6E8EE</Color>
    <Color x:Key="TextMutedColor">#FF8A93A6</Color>
    <Color x:Key="DangerColor">#FFE04848</Color>
    <Color x:Key="DangerSurfaceColor">#FF3A1A1A</Color>
    <Color x:Key="DangerBorderColor">#FF5A2828</Color>
    <Color x:Key="DangerTextColor">#FFFFC2C2</Color>
    <Color x:Key="SuccessColor">#FF42C97A</Color>
    <Color x:Key="WarningColor">#FFE6B450</Color>
    <Color x:Key="ChromeHoverColor">#22FFFFFF</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="{StaticResource ChromeHoverColor}" />

</ResourceDictionary>