<Window x:Class="DayZHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DayZHelper.Controls"
        mc:Ignorable="d"
        Title="DayZ Helper"
        Height="780" Width="600"
        MinHeight="660" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="{StaticResource AppIconImage}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geom.FinalLogo}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0" />
                    <TextBlock Text="DayZ Helper"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MenuButton" Style="{StaticResource ChromeButton}"
                            Content="{StaticResource Geom.Menu}" ToolTip="Menu (Esc to close)"
                            Click="MenuButton_Click" />
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}"
                            Content="{StaticResource Geom.Min}" ToolTip="Minimize"
                            Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}"
                            Content="{StaticResource Geom.Max}" ToolTip="Maximize"
                            Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                            Content="{StaticResource Geom.Close}" ToolTip="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel x:Name="ContentRoot" Margin="20,16,20,16" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="12" />
                        </StackPanel.RenderTransform>

                        <!-- Header -->
                        <Grid Margin="0,4,0,16">
                            <StackPanel>
                                <TextBlock Text="DayZ Helper" Style="{StaticResource H1}" />
                                <TextBlock Text="Launch the game, clean stale logs, and reconnect fast."
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Actions -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="StartDayzButton"
                                            Style="{StaticResource AccentButton}"
                                            Height="46"
                                            Click="StartDayzButton_Click"
                                            ToolTip="Launch DayZ via Steam">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Start DayZ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            x:Name="CleanFilesButton"
                                            Style="{StaticResource ButtonBase}"
                                            Height="46"
                                            Click="CleanFilesButton_Click"
                                            ToolTip="Review &amp; delete log/rpt/mdmp files (Ctrl+L)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Clean Up Files" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Last Server -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Last Server" Style="{StaticResource H2}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="StarFavoriteButton"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Save as favorite"
                                                Click="StarFavoriteButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE734;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Save" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RefreshServerButton"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Re-read settings file (F5)"
                                                Click="RefreshServerButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Refresh" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="LastServerName"
                                                       Text="Not loaded yet"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                                    <TextBlock x:Name="LastServerIp" Text="—" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}">
                                                    <TextBlock x:Name="LastServerPort" Text="—" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="PingDot" Width="9" Height="9"
                                                     Fill="{DynamicResource TextMutedBrush}"
                                                     Margin="0,0,6,0" />
                                            <TextBlock x:Name="PingText" Text="—"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="ConnectOfficialButton"
                                            Content="Connect (Official)"
                                            Style="{StaticResource AccentButton}"
                                            Click="ConnectOfficialButton_Click"
                                            ToolTip="Launch via Steam (Ctrl+R)" />
                                    <Button Grid.Column="2"
                                            x:Name="ConnectDzsaButton"
                                            Content="Connect via DZSA"
                                            Style="{StaticResource ButtonBase}"
                                            Click="ConnectDzsaButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Favorites -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Favorites" Style="{StaticResource H2}" />
                                    <Button HorizontalAlignment="Right"
                                            x:Name="PingAllButton"
                                            Style="{StaticResource IconButton}"
                                            Click="PingAllButton_Click"
                                            ToolTip="Ping all favorites">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xe839;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Ping all" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="FavoritesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2"
                                                    Padding="12,8"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Endpoint}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource Pill}"
                                                            VerticalAlignment="Center"
                                                            Margin="6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8"
                                                                     Fill="{Binding PingBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding PingText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource AccentButton}"
                                                            Padding="10,5"
                                                            Margin="0,0,4,0"
                                                            Tag="{Binding}"
                                                            Click="FavoriteConnect_Click"
                                                            ToolTip="Connect">
                                                        <TextBlock Text="&#xe768;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ButtonBase}"
                                                            Padding="8,5"
                                                            Tag="{Binding}"
                                                            Click="FavoriteRemove_Click"
                                                            ToolTip="Remove">
                                                        <TextBlock Text="&#xe74d;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoFavoritesHint"
                                           Text="No favorites yet — click Save above to keep a server here."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="2,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Direct Connect -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Direct Connect" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="IP / Hostname" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="Port" Style="{StaticResource Caption}" />

                                    <TextBox Grid.Row="2" Grid.Column="0"
                                             x:Name="IpBox"
                                             KeyDown="DirectInput_KeyDown" />
                                    <TextBox Grid.Row="2" Grid.Column="2"
                                             x:Name="PortBox"
                                             KeyDown="DirectInput_KeyDown" />
                                </Grid>

                                <Button x:Name="DirectConnectButton"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,12,0,0"
                                        Click="DirectConnectButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71B;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Connect" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Appearance settings -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Theme"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="ThemeCombo"
                                              SelectionChanged="ThemeCombo_Changed">
                                        <ComboBoxItem Content="System" />
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="Accent" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,12,0,6" />
                                <ItemsControl x:Name="AccentSwatches">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="28" Height="28"
                                                    Margin="0,0,6,6"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="AccentSwatch_Click"
                                                    ToolTip="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd"
                                                                Background="{Binding Brush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="2"
                                                                CornerRadius="14" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush"
                                                                        Value="{DynamicResource TextBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <CheckBox x:Name="MonitorLaunchBox"
                                          Content="Watch for DayZ launch (warn if Steam handoff fails)"
                                          ToolTip="Automatically close this helper once the game starts, or alert you if Steam fails to launch it within 20 seconds."
                                          Margin="0,8,0,0"
                                          Checked="MonitorLaunchBox_Changed"
                                          Unchecked="MonitorLaunchBox_Changed" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Toast layer -->
                <controls:ToastHost x:Name="Toasts" />
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="StatusText"
                               Text="Ready"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.4"
                                                             Duration="0:0:1.4"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="StatusBadge" Text="OK"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Menu popup -->
            <Popup Grid.Row="0" x:Name="MenuPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MenuButton}"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6"
                        Margin="0,2,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="3"
                                          Opacity="{DynamicResource ShadowOpacity}"
                                          Color="{DynamicResource ShadowColor}" />
                    </Border.Effect>
                    <StackPanel MinWidth="240">
                        <Button Content="Open DayZ Folder"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuOpenDayzFolder_Click" />
                        <Button Content="Open Settings File"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuOpenSettingsFile_Click" />
                        <Button Content="Open Cleanup Log"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuOpenCleanupLog_Click" />
                        <Border Style="{StaticResource HSep}" Margin="6,4" />
                        <Button Content="Change DayZ Folder…"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuChangeDayzFolder_Click" />
                        <Button Content="Change Steam Path…"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuChangeSteamPath_Click" />
                        <Button Content="Change Workshop Folder…"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuChangeWorkshopFolder_Click" />
                        <Border Style="{StaticResource HSep}" Margin="6,4" />
                        <Button Content="Re-register dzsal:// Protocol"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuRegisterDzsal_Click" />
                        <Border Style="{StaticResource HSep}" Margin="6,4" />
                        <Button Content="About"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                Click="MenuAbout_Click" />
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Border>
</Window>